    {
      "id": "VIGNUQCASr3AWCMzhpMic",
      "type": "text",
      "x": 3409.025400851714,
      "y": 588.6666666666665,
      "width": 800,
      "height": 350,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0t",
      "roundness": null,
      "seed": 421423107,
      "version": 1102,
      "versionNonce": 1883348675,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1790761996033,
      "created": 1790761231461,
      "link": null,
      "locked": false,
      "text": "Resolve is a \"Stamina Bar\" Type bar that increases the more you dodge and\nparry and combo. This resolve is used to increase your upgrade capacity. Because\nyou are a primitve pbot you are unable to handle the modern part upgrades of\ntoday however there is still a way. By increasing your resolve, you push through\nyour hardware limitations and gain the ability to increase your-upgrade capacity\ntemporarily.\n\nUpgrade-Capacity: The amount of upgrades you can have, you have 5 body parts,\ntwo arms, two legs, and a spine. Each can be upgraded individually, and each has\nan upgrade cost. If you exceed your total upgrade-capacity you have to\nunderload your parts. Increasing upgrade-capacity can help you temporarily\nincrease the load on these parts and use them to their full potential. Having the\nparts underloaded also comes with downsides which are reduced the more load\nyou can use.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Resolve is a \"Stamina Bar\" Type bar that increases the more you dodge and parry and combo. This resolve is used to increase your upgrade capacity. Because you are a primitve pbot you are unable to handle the modern part upgrades of today however there is still a way. By increasing your resolve, you push through your hardware limitations and gain the ability to increase your-upgrade capacity temporarily.\n\nUpgrade-Capacity: The amount of upgrades you can have, you have 5 body parts, two arms, two legs, and a spine. Each can be upgraded individually, and each has an upgrade cost. If you exceed your total upgrade-capacity you have to underload your parts. Increasing upgrade-capacity can help you temporarily increase the load on these parts and use them to their full potential. Having the parts underloaded also comes with downsides which are reduced the more load you can use.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
