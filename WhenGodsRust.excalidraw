      "text": "Core Mechanics:",
      "fontSize": 49.00000000000005,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Core Mechanics:",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "nOV8ePkXxJPXx13NjlIag",
      "type": "text",
      "x": 2116.3380677118544,
      "y": 484.27192544183595,
      "width": 952.9088836669916,
      "height": 478.1249999999997,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0W",
      "roundness": null,
      "seed": 249425613,
      "version": 766,
      "versionNonce": 966426637,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790762060085,
      "created": 1790760476890,
      "link": null,
      "locked": false,
      "text": "Resolve is a \"Stamina Bar\" Type bar that increases the more you dodge and\nparry and combo. This resolve is used to increase your upgrade capacity.\nBecause you are a primitve pbot you are unable to handle the modern part\nupgrades of today however there is still a way. By increasing your resolve,\nyou push through your hardware limitations and gain the ability to increase\nyour-upgrade capacity temporarily.\n\nUpgrade-Capacity: The amount of upgrades you can have, you have 5 body\nparts, two arms, two legs, and a spine. Each can be upgraded individually,\nand each has an upgrade cost. If you exceed your total upgrade-capacity\nyou have to underload your parts. Increasing upgrade-capacity can help you\ntemporarily increase the load on these parts and use them to their full\npotential. Having the parts underloaded also comes with downsides which\nare reduced the more load you can use.\n",
      "fontSize": 25.499999999999986,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Resolve is a \"Stamina Bar\" Type bar that increases the more you dodge and parry and combo. This resolve is used to increase your upgrade capacity. Because you are a primitve pbot you are unable to handle the modern part upgrades of today however there is still a way. By increasing your resolve, you push through your hardware limitations and gain the ability to increase your-upgrade capacity temporarily.\n\nUpgrade-Capacity: The amount of upgrades you can have, you have 5 body parts, two arms, two legs, and a spine. Each can be upgraded individually, and each has an upgrade cost. If you exceed your total upgrade-capacity you have to underload your parts. Increasing upgrade-capacity can help you temporarily increase the load on these parts and use them to their full potential. Having the parts underloaded also comes with downsides which are reduced the more load you can use.\n",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "YpZut6z8ECGMRP-HZcw5B",
